# Copy to .env for `pnpm dev` (the file is git-ignored).
DATABASE_URL=postgres://postgres:dev@127.0.0.1:5433/mdh
# At least 32 characters. Used to sign cookies and to encrypt project passwords. Changing it logs everyone out
# and makes stored project passwords unreadable.
APP_SECRET=change-me-to-a-long-random-string-0123456789
PORT=3000
# pnpm dev: the website's dev server forwards /api to this one. Behind a reverse proxy in production, also true.
TRUST_PROXY=true
# Optional. The address people use to reach the site, e.g. mdh.example.com (https is assumed) or http://localhost:3000.
# Used for the links in the Share dialog and for the cross-site check. Without it the address of the browser tab is used.
# PUBLIC_DOMAIN=mdh.example.com
