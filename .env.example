# Copy to .env, then: docker compose up -d --build
POSTGRES_PASSWORD=change-me
# At least 32 characters. Signs cookies and encrypts project passwords.
# Changing it logs everyone out and makes stored project passwords unreadable. Back it up.
APP_SECRET=change-me-to-a-long-random-string-0123456789
# Optional: the address people use, e.g. mdh.example.com (https assumed) or http://localhost:3000.
# https turns on Secure cookies by itself.
PUBLIC_DOMAIN=
# true only when a reverse proxy (Caddy, nginx, Traefik) sits in front and sets X-Forwarded-For / X-Forwarded-Host.
TRUST_PROXY=false
# Host port (default 3000).
PORT=3000
